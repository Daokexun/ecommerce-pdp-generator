{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ECommerceProductDetailPage",
  "description": "Standardized schema for high-converting product detail page output generated by ecommerce-pdp-generator skill.",
  "type": "object",
  "required": [
    "platform",
    "metadata",
    "headline_matrix",
    "p2b_feature_table",
    "aida_sections",
    "audit_scorecard"
  ],
  "properties": {
    "platform": {
      "type": "string",
      "enum": ["Amazon", "Shopify", "TikTok_Shop", "Generic_DTC"]
    },
    "metadata": {
      "type": "object",
      "properties": {
        "product_name": { "type": "string" },
        "target_audience": { "type": "string" },
        "core_keywords": { "type": "array", "items": { "type": "string" } },
        "golden_ranking_tier": {
          "type": "object",
          "properties": {
            "unique_advantage": { "type": "string" },
            "superior_performance": { "type": "string" },
            "distinct_positioning": { "type": "string" }
          }
        }
      }
    },
    "headline_matrix": {
      "type": "object",
      "properties": {
        "primary_title": { "type": "string" },
        "character_count": { "type": "integer" },
        "subheadline_or_tagline": { "type": "string" },
        "impulse_variant": { "type": "string" },
        "analytical_variant": { "type": "string" }
      }
    },
    "p2b_feature_table": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "raw_spec": { "type": "string" },
          "mechanism": { "type": "string" },
          "tangible_benefit": { "type": "string" },
          "emotional_payoff": { "type": "string" }
        }
      }
    },
    "aida_sections": {
      "type": "object",
      "properties": {
        "attention_hook": { "type": "string" },
        "interest_pain_points": { "type": "array", "items": { "type": "string" } },
        "desire_lifestyle_scenarios": { "type": "array", "items": { "type": "string" } },
        "trust_proof_points": { "type": "array", "items": { "type": "string" } },
        "action_cta_tiers": {
          "type": "object",
          "properties": {
            "new_customer": { "type": "string" },
            "hesitant_buyer": { "type": "string" },
            "repeat_bundle": { "type": "string" }
          }
        }
      }
    },
    "audit_scorecard": {
      "type": "object",
      "properties": {
        "hook_score": { "type": "number", "minimum": 0, "maximum": 20 },
        "p2b_score": { "type": "number", "minimum": 0, "maximum": 20 },
        "objection_score": { "type": "number", "minimum": 0, "maximum": 20 },
        "proof_score": { "type": "number", "minimum": 0, "maximum": 20 },
        "compliance_score": { "type": "number", "minimum": 0, "maximum": 20 },
        "composite_total": { "type": "number", "minimum": 0, "maximum": 100 },
        "passed": { "type": "boolean" }
      }
    }
  }
}
